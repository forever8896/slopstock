# Copy to .env and fill in. Never commit .env.

# ─── Chains ───────────────────────────────────────────────────────────
ZG_RPC_URL=https://evmrpc-testnet.0g.ai
ZG_CHAIN_ID=16601
BASE_RPC_URL=https://sepolia.base.org
BASE_CHAIN_ID=84532
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# ─── Wallets (NEVER commit) ────────────────────────────────────────────
DEPLOYER_PRIVATE_KEY=
OPERATOR_PRIVATE_KEY=

# ─── 0G Storage / Compute ──────────────────────────────────────────────
ZG_STORAGE_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai
ZG_COMPUTE_PROXY_URL=https://compute.0g.ai/v1/proxy
ZG_COMPUTE_API_KEY=

# ─── Operator agent runtime ────────────────────────────────────────────
AGENT_RUNTIME=openai-compat
# Per-tokenId override, JSON. Lets one operator serve N agents on different runtimes.
RUNTIME_BY_TOKEN_ID='{"1":"hermes","2":"openai-compat","3":"openai-compat"}'
AGENTS_DATA_DIR=./data/agents

# LLM backend ("openai-compat" or "0g-compute"). 0G Compute requires a
# funded broker ledger — see apps/operator/scripts/setup-0g-compute.ts.
COMPUTE_BACKEND=openai-compat
BACKEND_BY_TOKEN_ID='{"3":"0g-compute"}'
ZG_COMPUTE_PROVIDER_ADDRESS=0x69Eb5a0BD7d0f4bF39eD5CE9Bd3376c61863aE08

# ─── Compute backend (OpenAI-compatible HTTP) ──────────────────────────
COMPUTE_BASE_URL=http://127.0.0.1:11434/v1
COMPUTE_API_KEY=
COMPUTE_MODEL=qwen2.5-coder:7b

# ─── Operator on-chain anchors (from contracts/deployments) ────────────
AGENT_NFT_ADDRESS=
AGENT_REGISTRY_ADDRESS=
AGENT_VAULT_ADDRESS=

# ─── Receipt persistence ───────────────────────────────────────────────
RECEIPTS_DB_PATH=./data/receipts.db

# ─── KeeperHub ─────────────────────────────────────────────────────────
KEEPERHUB_API_KEY=
KEEPERHUB_BASE_URL=https://api.keeperhub.com

# ─── Uniswap / x402 ────────────────────────────────────────────────────
UNISWAP_ROUTER_ADDRESS=
X402_FACILITATOR_URL=https://x402.coinbase.com

# ─── ENS / CCIP-Read ───────────────────────────────────────────────────
ENS_GATEWAY_URL=https://gateway.stratum.app/api/ens/resolve
ENS_GATEWAY_SIGNER_KEY=

# ─── AXL ───────────────────────────────────────────────────────────────
AXL_BOOTSTRAP_PEER=tls://bootstrap.gensyn.ai:9000
AXL_LISTEN_PORT=9100
AXL_BRIDGE_PORT=9001

# ─── Frontend ──────────────────────────────────────────────────────────
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_INDEXER_URL=https://indexer.stratum.app

# ─── Indexer (Ponder) ──────────────────────────────────────────────────
PONDER_LOG_LEVEL=info
DATABASE_URL=postgres://localhost:5432/stratum

# ── Stateless operator (Walrus + Seal + ENS pointer) ──────────────────
STORAGE_BACKEND=walrus            # walrus | shadow (default walrus)
SNAPSHOT_ENCRYPTION=seal          # aes | seal  (aes = offline/CI + fallback; seal = live/bounty)
AGENT_SNAPSHOT_KEY=               # base64url 32B — AES key (fallback + Seal backup-key); unset = ephemeral (won't survive restart)
ENS_SNAPSHOT_ENABLED=1            # write agent-snapshot pointer on mainnet (1/true on)
L1_RPC=                           # Ethereum mainnet RPC (ENS pointer read/write)
SEAL_NETWORK=testnet              # testnet | mainnet (Seal is GA on both — see docs/nyc-2026/12-seal-mainnet-runbook.md)
SEAL_PACKAGE_ID=                  # published agent_seal package id (sui client publish)
SEAL_ALLOWLIST_ID=                # allowlist object id (seal-publish-policy.ts)
SEAL_THRESHOLD=2                  # t-of-n key-server approvals (need >= this many SEAL_KEY_SERVERS on mainnet)
SEAL_KEY_SERVERS=                 # comma-separated key-server object IDs; baked-in on testnet, REQUIRED on mainnet
SEAL_VERIFY_KEY_SERVERS=          # blank = true on mainnet / false on testnet; set true|false|1|0 to override
SUI_SEAL_KEYPAIR=                 # Sui keypair (suiprivkey… or 0x-hex); needs mainnet SUI gas to publish + create allowlist
WALRUS_EPOCHS=5                   # testnet epochs (90 broken on public publishers)
# ── Mainnet Seal (uncomment + fill from the runbook; encrypt/decrypt stay gasless) ──
# SEAL_NETWORK=mainnet
# SEAL_KEY_SERVERS=0x<server-1>,0x<server-2>   # >= SEAL_THRESHOLD verified mainnet servers (Seal "Verified Key Servers" page)
